## `cli.py`

```python id="aether-cli"
import argparse
from pathlib import Path

from .organizer import FileOrganizer


def main() -> None:

    parser = argparse.ArgumentParser(
        prog="aethervault",
        description=(
            "AetherVault — Intelligent "
            "file organization from the command line."
        )
    )

    parser.add_argument(
        "directory",
        type=Path,
        help="Directory to organize"
    )

    parser.add_argument(
        "--dry-run",
        action="store_true",
        help=(
            "Preview changes without "
            "moving any files"
        )
    )

    args = parser.parse_args()

    organizer = FileOrganizer(
        source=args.directory,
        dry_run=args.dry_run
    )

    try:
        organizer.organize()

    except (
        FileNotFoundError,
        NotADirectoryError
    ) as error:

        print(f"Error: {error}")


if __name__ == "__main__":
    main()
```

