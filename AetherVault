# Core Implementation

## `classifier.py`

```python id="aether-classifier"
from pathlib import Path


CATEGORIES = {
    "images": {
        ".jpg", ".jpeg", ".png", ".gif",
        ".webp", ".svg", ".bmp"
    },
    "documents": {
        ".pdf", ".doc", ".docx",
        ".txt", ".csv", ".xlsx",
        ".pptx"
    },
    "videos": {
        ".mp4", ".mkv", ".avi",
        ".mov", ".webm"
    },
    "audio": {
        ".mp3", ".wav", ".flac",
        ".aac", ".ogg"
    },
    "archives": {
        ".zip", ".rar", ".7z",
        ".tar", ".gz"
    },
    "code": {
        ".py", ".js", ".ts",
        ".java", ".cpp", ".c",
        ".html", ".css", ".json"
    }
}


def classify_file(file_path: Path) -> str:
    """
    Determine the category of a file based on its extension.

    Parameters
    ----------
    file_path : Path
        Path to the target file.

    Returns
    -------
    str
        The detected file category.
    """

    extension = file_path.suffix.lower()

    for category, extensions in CATEGORIES.items():
        if extension in extensions:
            return category

    return "other"
```

