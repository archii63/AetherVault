## `organizer.py`

```python id="aether-organizer"
from pathlib import Path
import shutil

from .classifier import classify_file


class FileOrganizer:
    """Handles safe file organization operations."""

    def __init__(
        self,
        source: Path,
        dry_run: bool = False
    ):
        self.source = source.expanduser().resolve()
        self.dry_run = dry_run
        self.processed = 0
        self.skipped = 0

    def _resolve_collision(
        self,
        destination: Path
    ) -> Path:
        """
        Generate a unique filename if a collision exists.
        """

        if not destination.exists():
            return destination

        counter = 1

        while True:
            candidate = destination.with_name(
                f"{destination.stem}_{counter}"
                f"{destination.suffix}"
            )

            if not candidate.exists():
                return candidate

            counter += 1

    def organize(self) -> None:
        """Organize all files in the source directory."""

        if not self.source.exists():
            raise FileNotFoundError(
                f"Directory not found: {self.source}"
            )

        if not self.source.is_dir():
            raise NotADirectoryError(
                f"Not a directory: {self.source}"
            )

        for file_path in self.source.iterdir():

            if file_path.is_dir():
                continue

            if file_path.name.startswith("."):
                self.skipped += 1
                continue

            category = classify_file(file_path)

            destination_dir = (
                self.source / category
            )

            destination = (
                destination_dir / file_path.name
            )

            destination = self._resolve_collision(
                destination
            )

            if self.dry_run:
                print(
                    f"[DRY RUN] "
                    f"{file_path.name} "
                    f"→ {category}/"
                )
            else:
                destination_dir.mkdir(
                    parents=True,
                    exist_ok=True
                )

                shutil.move(
                    str(file_path),
                    str(destination)
                )

                print(
                    f"[MOVED] "
                    f"{file_path.name} "
                    f"→ {category}/"
                )

            self.processed += 1

        self._print_summary()

    def _print_summary(self) -> None:
        """Display the final operation summary."""

        print("\nOperation completed")
        print("-------------------")
        print(f"Processed: {self.processed}")
        print(f"Skipped:   {self.skipped}")
        print(
            f"Mode:      "
            f"{'DRY RUN' if self.dry_run else 'LIVE'}"
        )
```

